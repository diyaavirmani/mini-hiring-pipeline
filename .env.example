# Copy to .env and replace the secret before starting the app.
APP_SECRET_KEY=replace-with-at-least-32-random-characters
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///./data/hiring_pipeline.sqlite3
# Optional. Without a key, unsupported searches return a helpful explanation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
